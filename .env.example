# Copy to .env and fill in real values. Never commit the real .env.
# In deployed environments this is injected from AWS Secrets Manager, not a file.

OPENAI_API_KEY=sk-...

# Optional — defaults shown. Set explicitly in containers.
# CHROMA_DIR=/app/chroma_db
# API_KEY=                      # shared secret required by the /ask endpoints
# HISTORY_TABLE=rag-api-history # DynamoDB table for conversation history
# HISTORY_BACKEND=local         # "local" (in-memory) or "dynamodb"
